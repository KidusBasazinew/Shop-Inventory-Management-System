# ---- existing required vars (already in your .env) ----
# DATABASE_URL=
# JWT_ACCESS_SECRET=
# JWT_ACCESS_EXPIRES_IN=15m
# REFRESH_TOKEN_EXPIRES_DAYS=30
# CHAPA_SECRET_KEY=
# CHAPA_WEBHOOK_SECRET=
# CHAPA_CALLBACK_URL=
# CHAPA_RETURN_URL=

# ---- subscription / billing ----
MONTHLY_PRICE_ETB=1000

# Platform admin account (created by `npm run prisma:seed`)
ADMIN_EMAIL=admin@platform.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Platform Admin

# Optional demo shop for local testing (`npm run prisma:seed`)
# DEMO_SHOP_PHONE=0912345678
# DEMO_SHOP_PASSWORD=demo1234

# ---- screenshot storage (Cloudinary) ----
# Set all three to store uploaded payment screenshots in Cloudinary.
# `screenshotUrl` in the DB then holds the https CDN URL and the
# dashboard renders images straight from Cloudinary.
# Leave unset to fall back to private local disk (dev mode).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix in your Cloudinary media library
CLOUDINARY_FOLDER=payment-screenshots

# ---- AI verification of payment screenshots (15-minute fallback) ----
# "stub" = dev-only heuristic that never auto-decides (always defers to
# human review). Set to "openai" + add OPENAI_API_KEY for real checks —
# it reads Cloudinary URLs directly, no local file needed.
AI_PROVIDER=stub
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Confidence (0..1) the AI needs to auto-approve / auto-reject on its own.
# Below this, payments stay PENDING for you to review manually.
AUTO_AI_THRESHOLD=0.8
# Minutes after submission before the AI fallback runs.
AUTO_AI_MINUTES=15

# ---- background scheduler (reminders 3/2/1 days out, expiry sweep) ----
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Local dev fallback dir for screenshots when Cloudinary is not configured
# UPLOADS_DIR=uploads
